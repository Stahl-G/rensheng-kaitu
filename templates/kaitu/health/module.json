{
  "id": "health",
  "name": "健康",
  "version": 1,
  "visibility": "nav",
  "description": "训练、饮食、睡眠活动与身体指标",
  "tabs": ["workouts", "meals", "sleep-activity", "metrics"],
  "records": {
    "workout": {
      "path": "data/workouts/{YYYY-MM}.jsonl",
      "schema": "schemas/workout.schema.json",
      "label": "训练"
    },
    "meal": { "path": "data/meals/{YYYY-MM}.jsonl", "schema": "schemas/meal.schema.json", "label": "饮食" },
    "supplement": {
      "path": "data/supplements/{YYYY-MM}.jsonl",
      "schema": "schemas/supplement.schema.json",
      "label": "补充剂"
    },
    "sleep": { "path": "data/sleep/{YYYY-MM}.jsonl", "schema": "schemas/sleep.schema.json", "label": "睡眠" },
    "activity": {
      "path": "data/activity/{YYYY-MM}.jsonl",
      "schema": "schemas/activity.schema.json",
      "label": "活动"
    },
    "metric": {
      "path": "data/metrics/{YYYY-MM}.jsonl",
      "schema": "schemas/metric.schema.json",
      "label": "指标"
    }
  },
  "views": [
    {
      "type": "chart",
      "title": "体重趋势",
      "record": "metric",
      "filter": { "kind": "weight" },
      "x": "ts",
      "y": "value"
    },
    {
      "type": "table",
      "title": "训练日志",
      "record": "workout",
      "columns": ["ts", "exercise", "sets", "reps", "weight_kg"]
    },
    {
      "type": "table",
      "title": "饮食记录",
      "record": "meal",
      "columns": ["ts", "meal", "kcal", "protein_g"]
    },
    { "type": "chart", "title": "睡眠时长", "record": "sleep", "x": "ts", "y": "duration_min" }
  ],
  "sources": [
    { "type": "import", "id": "apple-health" },
    { "type": "api", "id": "oura" },
    { "type": "import", "id": "nut-ai" },
    { "type": "api", "id": "caloriemate" },
    { "type": "manual" }
  ],
  "agent": {
    "instructions": "记录训练时按 workout schema 写入，同一次训练的各个动作用同一个 session_id；每次训练后对比上次同动作的重量，给出下次加重建议。饮食写 meal，蛋白粉、肌酸等写 supplement。体检报告抽取结果写 data/labs/YYYY-MM-DD-<slug>.json，原件放 files/。只做记录、趋势与提醒，不做医疗诊断。"
  }
}
