  "productPatch": "diff --git a/packages/cli/src/ui/server.ts b/packages/cli/src/ui/server.ts\nindex a22bceb..ad95432 100644\n--- a/packages/cli/src/ui/server.ts\n+++ b/packages/cli/src/ui/server.ts\n@@ -249,7 +249,8 @@ export async function startUi(ws: Workspace, input: UiOptions = {}) {\n     messages = [];\n     let pending = true;\n     const version = await snapshotNow(ws, (files) => {\n-      pending = files.length > 0;\n+      // 外部收件箱仍等处理；用户显式保存的原文不能因只剩 inbox 文件而丢掉版本请求。\n+      pending = files.length > 0 || own.length > 0;\n       if (!pending) return null;\n       return own.length\n         ? own.join(\"；\")\n@@ -355,7 +356,7 @@ export async function startUi(ws: Workspace, input: UiOptions = {}) {\n         // 目录暂不存在（iCloud 未同步或未配置），启动拉取与后续事件会重试\n       }\n     }\n-    stopPhone = startPhoneSnapshots(ws, () => reportError());\n+    stopPhone = startPhoneSnapshots(ws, () => reportError(), watcher);\n     scheduleInbox();\n   }\n   await startWatching();\ndiff --git a/packages/core/src/history.ts b/packages/core/src/history.ts\nindex ef217ca..8a164ad 100644\n--- a/packages/core/src/history.ts\n+++ b/packages/core/src/history.ts\n@@ -246,6 +246,14 @@ export async function snapshot(ws: Workspace, message: string, now = new Date())\n \n type SnapshotMessage = string | ((files: readonly string[]) => string | null);\n \n+function unavailableHistoryWrite(error: unknown): boolean {\n+  if (error instanceof git.Errors.MultipleGitError)\n+    return error.errors.length > 0 && error.errors.every(unavailableHistoryWrite);\n+  return [\"EPERM\", \"EACCES\", \"EROFS\", \"ENOSPC\"].includes(\n+    (error as NodeJS.ErrnoException | undefined)?.code ?? \"\",\n+  );\n+}\n+\n /** 立刻存版本；可用本次盘点生成说明，返回 null 则跳过本次提交。 */\n export async function snapshotNow(\n   ws: Workspace,\n@@ -256,9 +264,8 @@ export async function snapshotNow(\n   try {\n     return await saveSnapshot(ws, message, now);\n   } catch (error) {\n-    const code = (error as NodeJS.ErrnoException).code;\n     if (error instanceof KaituError && error.code === \"CLOUD_UNAVAILABLE\") return null;\n-    if (![\"EPERM\", \"EACCES\", \"EROFS\", \"ENOSPC\"].includes(code ?? \"\")) throw error;\n+    if (!unavailableHistoryWrite(error)) throw error;\n     console.warn(\"数据已保存，版本稍后由开图补存（运行 kaitu ui 或 kaitu snapshot）\");\n     return null;\n   }\ndiff --git a/packages/core/src/phone-snapshots.ts b/packages/core/src/phone-snapshots.ts\nindex baf87fc..fece9ed 100644\n--- a/packages/core/src/phone-snapshots.ts\n+++ b/packages/core/src/phone-snapshots.ts\n@@ -55,7 +55,11 @@ export async function writePhoneSnapshots(\n }\n \n /** 常驻进程在后台生成，监听只负责失效；同步盘漏事件时每分钟补看一次。 */\n-export function startPhoneSnapshots(ws: Workspace, report: (error: unknown) => void = () => {}) {\n+export function startPhoneSnapshots(\n+  ws: Workspace,\n+  report: (error: unknown) => void = () => {},\n+  sharedWatcher?: ReturnType<typeof watchWorkspace>,\n+) {\n   let timer: NodeJS.Timeout | undefined;\n   let running: Promise<void> | undefined;\n   let again = false;\n@@ -87,13 +91,16 @@ export function startPhoneSnapshots(ws: Workspace, report: (error: unknown) => v\n   };\n   let watcher: ReturnType<typeof watchWorkspace> | undefined;\n   try {\n-    watcher = watchWorkspace(ws.root, (file) => {\n-      if (!ignoredWorkspaceChange(file)) schedule();\n-    });\n-    watcher.on(\"error\", () => {\n-      watcher?.close();\n-      watcher = undefined;\n-    });\n+    if (sharedWatcher) sharedWatcher.on(\"all\", schedule).on(\"ready\", schedule);\n+    else {\n+      watcher = watchWorkspace(ws.root, (file) => {\n+        if (!ignoredWorkspaceChange(file)) schedule();\n+      });\n+      watcher.on(\"error\", () => {\n+        watcher?.close();\n+        watcher = undefined;\n+      });\n+    }\n   } catch {\n     /* 不支持递归监听时由定时器刷新。 */\n   }\n@@ -106,6 +113,8 @@ export function startPhoneSnapshots(ws: Workspace, report: (error: unknown) => v\n     clearTimeout(timer);\n     clearInterval(interval);\n     off();\n+    // 借用 UI 的监听时只退订，关闭仍由 UI 在迁移 / 退出前负责。\n+    sharedWatcher?.off(\"all\", schedule).off(\"ready\", schedule);\n     await watcher?.close();\n     await running;\n   };\n",
