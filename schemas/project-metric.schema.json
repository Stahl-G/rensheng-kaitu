{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaitu.local/schemas/project-metric.schema.json",
  "title": "项目进度",
  "allOf": [
    {
      "$ref": "record-base.schema.json"
    }
  ],
  "required": ["project", "kind", "value"],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "examples": ["example-project"]
    },
    "kind": {
      "enum": ["words", "commits"]
    },
    "value": {
      "type": "number",
      "minimum": 0
    },
    "detail": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 80
      }
    }
  }
}
