{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaitu.local/schemas/photo.schema.json",
  "title": "体态照片",
  "allOf": [
    {
      "$ref": "record-base.schema.json"
    }
  ],
  "required": ["file", "pose"],
  "properties": {
    "file": {
      "type": "string",
      "pattern": "^files/photos/\\d{4}-\\d{2}-\\d{2}-[0-9A-HJKMNP-TV-Z]{26}\\.(jpg|png|webp)$"
    },
    "pose": {
      "enum": ["front", "side", "back", "other"]
    },
    "notes": {
      "type": "string"
    }
  }
}
