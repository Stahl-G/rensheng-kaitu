{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaitu.local/schemas/module.schema.json",
  "title": "module.json",
  "type": "object",
  "required": ["id", "name", "version", "visibility"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "visibility": { "enum": ["nav", "agent"] },
    "description": { "type": "string" },
    "tabs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
    "records": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["path", "schema"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*\\{YYYY-MM\\}\\.jsonl$" },
          "schema": { "type": "string", "pattern": "^(?!.*\\.\\.)[a-z0-9/_-]+\\.schema\\.json$" },
          "label": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title"],
        "properties": {
          "type": { "enum": ["table", "kanban", "timeline", "chart", "progress", "doc"] },
          "title": { "type": "string" },
          "record": { "type": "string" },
          "filter": { "type": "object" },
          "x": { "type": "string" },
          "y": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "path": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["import", "api", "mcp", "manual"] },
          "id": { "type": "string" }
        }
      }
    },
    "agent": {
      "type": "object",
      "properties": { "instructions": { "type": "string" } }
    }
  }
}
