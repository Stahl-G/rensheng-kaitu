{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaitu.local/schemas/news-item.schema.json",
  "title": "新闻",
  "allOf": [
    {
      "$ref": "record-base.schema.json"
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "const": "x_post"
          }
        }
      },
      "then": {
        "required": ["post"]
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "const": "release"
          }
        }
      },
      "then": {
        "required": ["version"]
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": {
            "const": "paper"
          }
        }
      },
      "then": {
        "required": ["authors"]
      }
    }
  ],
  "required": ["title", "url", "source", "via", "status"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "via": {
      "enum": ["rss", "grok", "dot", "codex", "agent", "user"]
    },
    "summary": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "relevance": {
      "type": "object",
      "required": ["module", "reason"],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": ["new", "tried", "dismissed"],
      "default": "new"
    },
    "kind": {
      "enum": ["article", "x_post", "paper", "release", "video", "podcast", "rss"],
      "default": "article"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "quote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "venue": {
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "duration": {
      "type": "string",
      "minLength": 1
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "text"],
        "properties": {
          "time": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "details": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "post": {
      "$ref": "#/$defs/post"
    },
    "discussion": {
      "$ref": "#/$defs/discussion"
    },
    "comment": {
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "title": "Lean 标准库更新",
      "url": "https://example.com/lean",
      "source": "Lean 官方博客",
      "via": "rss",
      "status": "new"
    }
  ],
  "$defs": {
    "post": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "media": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "reposts": {
          "type": "integer",
          "minimum": 0
        },
        "replies": {
          "type": "integer",
          "minimum": 0
        },
        "posted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "discussion": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["stance", "quote", "who"],
        "properties": {
          "stance": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "who": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "description": "Agent 新闻（via 非 rss/user）须有 summary、details、comment、published_at。类型缺省为 article。"
}
