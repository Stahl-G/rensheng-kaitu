{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaitu.local/schemas/sleep.schema.json",
  "title": "睡眠",
  "allOf": [{ "$ref": "record-base.schema.json" }],
  "required": ["start", "end", "duration_min", "source"],
  "properties": {
    "start": { "type": "string", "format": "date-time" },
    "end": { "type": "string", "format": "date-time" },
    "duration_min": { "type": "number", "minimum": 0 },
    "stages": {
      "type": "array",
      "description": "可选原始睡眠阶段；时间落在 start/end 内，重叠保留，缺失时不推算阶段",
      "items": {
        "type": "object",
        "required": ["start", "end", "stage"],
        "additionalProperties": false,
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "stage": {
            "enum": ["awake", "asleep_unspecified", "asleep_core", "asleep_deep", "asleep_rem", "in_bed"]
          }
        }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "hrv": { "type": "number", "minimum": 0 },
    "resting_hr": { "type": "number", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 }
  }
}
