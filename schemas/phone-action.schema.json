{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaitu.local/schemas/phone-action.schema.json",
  "title": "手机操作（inbox/agents/ios-*.actions.jsonl 的一行）",
  "description": "手机交给电脑执行的一次操作。电脑先核对前提（这一项还在、仍是待办或待确认），不满足记为 conflict；同一 client_id 只执行一次。",
  "type": "object",
  "required": ["client_id", "at", "device", "op", "args"],
  "properties": {
    "client_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID，手机生成" },
    "at": { "type": "string", "format": "date-time" },
    "device": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "op": {
      "enum": [
        "complete_next",
        "decide_proposal",
        "adopt_task",
        "complete_task",
        "create_task",
        "update_task",
        "cancel_task",
        "keep_draft",
        "adopt_draft",
        "answer_question",
        "trial_checkin",
        "replace_memory",
        "capture_memory"
      ]
    },
    "args": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "op": { "const": "complete_next" } } },
      "then": {
        "properties": {
          "args": {
            "required": ["file", "id"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "decide_proposal" } } },
      "then": {
        "properties": {
          "args": {
            "required": ["id", "decision"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["confirmed", "rejected"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "enum": ["adopt_task", "complete_task", "cancel_task"] } } },
      "then": {
        "properties": {
          "args": {
            "required": ["id"],
            "properties": { "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "keep_draft" } } },
      "then": {
        "properties": {
          "args": { "required": ["source"], "properties": { "source": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "adopt_draft" } } },
      "then": {
        "properties": {
          "args": {
            "required": ["source", "draft"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "draft": {
                "type": "object",
                "required": ["goal", "current", "next"],
                "properties": {
                  "goal": { "type": "string", "minLength": 1 },
                  "current": { "type": "string", "minLength": 1 },
                  "next": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "answer_question" } } },
      "then": {
        "properties": {
          "args": {
            "required": ["question_id", "value"],
            "properties": {
              "question_id": { "type": "string", "minLength": 1 },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "trial_checkin" } } },
      "then": {
        "properties": {
          "args": {
            "required": ["experiment_id", "done"],
            "properties": {
              "experiment_id": { "type": "string", "minLength": 1 },
              "done": { "type": "boolean" },
              "date": { "type": "string", "format": "date" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "create_task" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "required": ["id", "expected_rev", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
              "expected_rev": { "const": 0 },
              "title": { "type": "string", "minLength": 1 },
              "due": {
                "type": ["string", "null"],
                "anyOf": [{ "format": "date" }, { "format": "date-time" }, { "type": "null" }]
              },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "const": "update_task" } } },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "required": ["id", "expected_rev"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
              "expected_rev": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 },
              "due": {
                "type": ["string", "null"],
                "anyOf": [{ "format": "date" }, { "format": "date-time" }, { "type": "null" }]
              },
              "notes": { "type": "string" }
            },
            "anyOf": [{ "required": ["title"] }, { "required": ["due"] }, { "required": ["notes"] }]
          }
        }
      }
    },
    {
      "if": { "properties": { "op": { "enum": ["complete_task", "cancel_task"] } } },
      "then": {
        "properties": { "args": { "properties": { "expected_rev": { "type": "integer", "minimum": 1 } } } }
      }
    },
    {
      "if": { "properties": { "op": { "const": "complete_next" } } },
      "then": { "properties": { "args": { "properties": { "expected_next": { "type": "object" } } } } }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "replace_memory"
          }
        }
      },
      "then": {
        "properties": {
          "args": {
            "type": "object",
            "required": ["file", "candidate", "expected"],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[^./\\\\][^/\\\\]*\\.md$"
              },
              "candidate": {
                "oneOf": [
                  {
                    "type": "null",
                    "description": "用户确认这条不再成立，仅归档，不替换"
                  },
                  {
                    "type": "object",
                    "required": ["type", "name", "text"],
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "enum": ["preference", "fact", "context", "person", "decision"]
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "string"
                      },
                      "sensitive": {
                        "type": "boolean"
                      }
                    }
                  }
                ]
              },
              "expected": {
                "type": "object",
                "required": ["type", "name", "text", "source", "sensitive"],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": ["preference", "fact", "context", "person", "decision"]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": ["string", "null"]
                  },
                  "sensitive": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "capture_memory"
          }
        }
      },
      "then": {
        "required": ["origin"],
        "properties": {
          "origin": {
            "const": "assistant"
          },
          "args": {
            "type": "object",
            "properties": {
              "idempotency_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "type": {
                "type": "string",
                "enum": ["preference", "fact", "context", "person", "decision"]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "origin": {
                "type": "string",
                "enum": ["user-stated", "ai-estimate", "ai-suggestion"]
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "uncertainty": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sensitive": {
                "type": "boolean"
              },
              "scope": {
                "type": "string",
                "enum": ["personal", "temporary", "quoted", "hypothetical"]
              },
              "conflict": {
                "type": "string",
                "minLength": 1
              },
              "replaces": {
                "type": "string"
              },
              "expected": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["preference", "fact", "context", "person", "decision"]
                  },
                  "name": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "source": {
                    "type": ["string", "null"]
                  },
                  "sensitive": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "name", "text", "source", "sensitive"],
                "additionalProperties": false
              }
            },
            "required": [
              "idempotency_key",
              "type",
              "name",
              "text",
              "source",
              "origin",
              "observed_at",
              "evidence",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
