{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "record-base.schema.json"
    }
  ],
  "unevaluatedProperties": false,
  "$id": "https://kaitu.local/schemas/experience-batch.schema.json",
  "title": "足迹导入批次",
  "required": [
    "state",
    "parser",
    "input_count",
    "duplicate_count",
    "excluded_count",
    "items",
    "withdrawn",
    "updated_at"
  ],
  "properties": {
    "state": {
      "enum": ["committed", "undone"]
    },
    "parser": {
      "type": "string",
      "minLength": 1
    },
    "input_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_count": {
      "type": "integer",
      "minimum": 0
    },
    "excluded_count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "revision"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "withdrawn": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "revision", "restore_revision"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "restore_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
